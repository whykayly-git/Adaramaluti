# --- Paystack (NGN payments) ---
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Server-side only. Start with sk_test_... for sandbox mode.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (international card payments) ---
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get this from https://dashboard.stripe.com/test/webhooks after creating
# an endpoint pointing to /api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Flutterwave (alternative local + international payments) ---
# Get your keys from https://app.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:4100

# --- Admin dashboard (/admin) ---
# Manage submissions, shop, collections and lookbook, plus other admin
# accounts. Admin accounts live in the database (see lib/db.ts), created
# from inside the dashboard — but the very first one has nowhere to come
# from yet, so ADMIN_EMAIL + ADMIN_PASSWORD act as a one-time bootstrap
# login: the first successful login with these credentials creates that
# admin account for real. After that, invite more admins from /admin/admins
# instead of relying on these.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used on the /admin/forgot-password page to reset a forgotten admin
# password without needing an email service. Keep this secret — treat it
# like a second password.
ADMIN_RECOVERY_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
